# Optional Telegram alerts. Leave placeholders unchanged to keep Telegram disabled.
TELEGRAM_BOT_TOKEN=your_bot_token_here
TELEGRAM_CHAT_ID=your_chat_id_here

# Optional administrator email notifications. Use an email provider's app password.
# Gmail example: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_STARTTLS=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
ALERT_FROM_EMAIL=
ADMIN_EMAIL=
SMTP_USE_SSL=false
SMTP_STARTTLS=true

# Phone detection downloads the small YOLOv4-tiny COCO model (~23 MB) on first run.
PHONE_DETECTION_ENABLED=true
PHONE_CONFIDENCE=0.35
PHONE_CONFIRM_SECONDS=0.35

# Optional tuning. Database and model files default to this project folder.
# DATABASE_PATH=events.sqlite3
# ALERT_COOLDOWN_SECONDS=5
# LOOK_AWAY_SECONDS=2
# CAMERA_INDEX=0
# SHOW_WINDOW=true
# FACE_BACKEND=auto
# FLIP_FRAME=false
# MIRROR_DIRECTIONS=false
# YAW_THRESHOLD_DEG=25
# PITCH_THRESHOLD_DEG=18
# ALERT_ON_SUSPICIOUS_MOVEMENT=false
